{
  "hosting": {
    "public": "out",
    "headers": [
      {
        "source": "/Ashlee-Herken-Resume.pdf",
        "headers": [
          { "key": "Content-Disposition", "value": "attachment" }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
